{
  "name": "study-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "extract": "tsx scripts/extract-mirror.ts",
    "predev": "npm run extract",
    "dev": "vite",
    "prebuild": "npm run extract",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretest": "npm run extract",
    "test": "vitest run",
    "pretypecheck": "npm run extract",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "server": "tsx watch server/main.ts",
    "server:start": "tsx server/main.ts"
  },
  "dependencies": {
    "driver.js": "^1.9.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
